generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tag {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(50)
  color       String          @db.VarChar(20)
  createdAt   DateTime        @default(now()) @map("created_at")
  experiments ExperimentTag[]

  @@map("tags")
}

model ProjectSection {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(100)
  content   String   @db.LongText
  sortOrder Int      @default(0) @map("sort_order")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_sections")
}

model ProjectAttachment {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(200)
  fileUrl    String   @db.VarChar(500) @map("file_url")
  fileSize   BigInt?  @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("project_attachments")
}

model Experiment {
  id        Int               @id @default(autoincrement())
  title     String            @db.VarChar(200)
  recorder  String            @db.VarChar(50)
  expDate   DateTime          @map("exp_date") @db.Date
  summary   String            @db.Text
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  images    ExperimentImage[]
  tags      ExperimentTag[]
  notes     ExperimentNote[]

  @@map("experiments")
}

model ExperimentImage {
  id           Int        @id @default(autoincrement())
  experimentId Int        @map("experiment_id")
  imageUrl     String     @db.VarChar(500) @map("image_url")
  sortOrder    Int        @default(0) @map("sort_order")
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@map("experiment_images")
}

model ExperimentTag {
  experimentId Int        @map("experiment_id")
  tagId        Int        @map("tag_id")
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experimentId, tagId])
  @@map("experiment_tags")
}

model ExperimentNote {
  id           Int        @id @default(autoincrement())
  experimentId Int        @map("experiment_id")
  content      String     @db.LongText
  createdAt    DateTime   @default(now()) @map("created_at")
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@map("experiment_notes")
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  className String?  @map("class_name") @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  studentNo String?  @map("student_no") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("team_members")
}

model Advisor {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  contact   String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("advisors")
}

model DashboardSetting {
  id            Int      @id
  projectName   String   @map("project_name") @db.LongText
  teamMembers   String   @map("team_members") @db.LongText
  advisors      String   @db.LongText
  progressSteps Json     @map("progress_steps")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("dashboard_settings")
}

enum TodoPriority {
  critical
  high
  medium
  low
}

model Todo {
  id        Int          @id @default(autoincrement())
  title     String       @db.VarChar(200)
  level     TodoPriority @default(medium)
  dueDate   DateTime     @map("due_date") @db.Date
  detail    String       @db.Text
  done      Boolean      @default(false)
  deletedAt DateTime?    @map("deleted_at") @db.DateTime(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("todos")
}
